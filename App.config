<?xml version="1.0" encoding="utf-8" ?>

<!-- Archivo de configuración general de la aplicación. -->
<configuration>

	<!-- Contiene las conexiones utilizadas por Prana. -->
	<connectionStrings>

		<!--
			ConexionPrana es el nombre que busca la clase Conexion.cs.

			Data Source indica que se utilizará SQL Server LocalDB.

			Initial Catalog indica que la aplicación trabajará
			con la base PranaElectronica.

			Integrated Security permite utilizar la cuenta actual
			de Windows sin guardar un usuario ni una contraseña SQL.

			Encrypt=False evita exigir un certificado para esta
			conexión local dentro de la misma computadora.

			Connect Timeout establece un máximo de 30 segundos
			para intentar abrir la conexión.
		-->
		<add name="ConexionPrana"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PranaElectronica;Integrated Security=True;Encrypt=False;Connect Timeout=30;"
			 providerName="Microsoft.Data.SqlClient" />

	</connectionStrings>

</configuration>