@startuml
allowmixing
title 02 - Ventas, deuda y comprobantes
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #40576B
  ArrowColor #40576B
}

package "Presentacion" #EAF3FA {
  class frmNuevaVenta <<formulario>> {
    -clienteElegido : Cliente
    -detallesVenta : List<DetalleNuevaVenta>
    -pagosVenta : List<PagoNuevaVenta>
    -RegistrarVenta()
  }
  class OpcionCliente <<clase interna>> {
    +Cliente
    +ToString()
  }
  class OpcionProducto <<clase interna>> {
    +Producto : producto
    +Variante : VarianteProducto
    +ToString()
  }
  class frmDeudaCliente <<formulario modal>> {
    -cliente : Cliente
    +frmDeudaCliente(Cliente)
  }
  class DocumentosPrana <<servicio de presentacion>> {
    +MostrarVenta(IWin32Window, int, String)
    +GuardarVenta(ComprobanteVenta)
    +Abrir(String)
  }
  class frmComprobantes <<formulario modal>> {
    -carpeta : String
    -numero : int
    -Abrir(String)
  }
}

rectangle "Negocio\nCN_Cliente, CN_Producto\nCN_MedioPago, CN_RegistroVenta\nCN_Venta, CN_Comprobante" as negocio #E8F5E9
rectangle "Entidades\nCliente, producto, VarianteProducto\nNuevaVenta, DetalleNuevaVenta\nPagoNuevaVenta, ComprobanteVenta" as entidades #FFF8E1

frmNuevaVenta o-- OpcionCliente
frmNuevaVenta o-- OpcionProducto
frmNuevaVenta ..> negocio : consulta y registra
frmNuevaVenta ..> entidades : captura y presenta
frmDeudaCliente ..> negocio : consulta saldo
frmDeudaCliente ..> entidades : muestra cliente y ventas
DocumentosPrana ..> negocio : obtiene comprobante
DocumentosPrana ..> entidades : genera documento
DocumentosPrana --> frmComprobantes : presenta archivos
frmComprobantes ..> DocumentosPrana : abre garantia/remito

note bottom
Los formularios heredan de Form
Los servicios y entidades se agrupan para mantener legible la lamina
end note
@enduml
