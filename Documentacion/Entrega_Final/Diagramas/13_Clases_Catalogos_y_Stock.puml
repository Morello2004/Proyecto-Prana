@startuml
allowmixing
title 03 - Catalogos y stock
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #40576B
  ArrowColor #40576B
}

package "Presentacion" #EAF3FA {
  class frmClientes <<formulario>> {
    -CargarClientes()
    -ElegirSugerencia()
  }
  class OpcionCliente <<clase interna>> {
    +Cliente
    +ToString()
  }
  class frmStock <<formulario>> {
    -variantesTemporales : BindingList<VarianteProducto>
    -ingresoTemporales : BindingList<VarianteProducto>
    -btnGuardarProducto_Click()
    -ButtonRegistrarIngreso_Click()
  }
  class buttonSeleccionarProducto <<formulario modal>> {
    +ProductoSeleccionado : producto
    +VarianteSeleccionada : VarianteProducto
    +OnVarianteSeleccionada(VarianteProducto, producto)
  }
  class frmMediosPagos <<formulario>> {
    -idMedioPagoSeleccionado : int
    -CargarMedios()
    -ObtenerMedioDesdeFormulario()
  }
  class EstiloGestion <<utilidad visual>> {
    ~Grilla(DataGridView)
    ~Columna(DataGridView, String, String, int, String)
  }
}

rectangle "Negocio\nCN_Cliente, CN_Producto\nCN_Proveedor, CN_Marca\nCN_Categoria, CN_MedioPago\nCN_LogActividad" as negocio #E8F5E9
rectangle "Entidades\nCliente, Localidad, producto\nVarianteProducto, Proveedor\nMarca, Categoria, MedioPago\nTiposCaja" as entidades #FFF8E1

frmClientes o-- OpcionCliente
frmClientes ..> negocio : gestiona clientes
frmClientes ..> entidades : muestra clientes
frmStock ..> negocio : consulta y actualiza
frmStock ..> entidades : edita catalogo y stock
frmStock --> buttonSeleccionarProducto : selecciona variante
buttonSeleccionarProducto ..> negocio : busca productos
buttonSeleccionarProducto ..> entidades : devuelve seleccion
frmMediosPagos ..> negocio : actualiza recargos
frmMediosPagos ..> entidades : configura medios
frmStock ..> EstiloGestion

note bottom
Los formularios heredan de Form
La utilidad visual compartida configura grillas de catalogos
end note
@enduml
