@startuml
allowmixing
title 04 - Pagos y entregas
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 34
skinparam ranksep 42
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #40576B
  ArrowColor #40576B
}

package "Presentacion" #EAF3FA {
  class frmPagos <<formulario>> {
    -Buscar()
    -MostrarCobro()
    -Registrar()
  }
  class frmEntregas <<formulario>> {
    -Buscar()
    -Preparar()
    -Confirmar()
  }
  class EstiloGestion <<utilidad visual>> {
    ~Grilla(DataGridView)
  }
}

rectangle "Negocio\nCN_Pago, CN_MedioPago\nCN_Entrega, Permisos\nSesionActual" as negocio #E8F5E9
rectangle "Entidades\nventa, MedioPago\nPagoRegistrado, CobroVenta\nProductoPorEntregar\nEntregaRegistrada" as entidades #FFF8E1

frmPagos ..> negocio : registra cobros
frmPagos ..> entidades : presenta venta y pagos
frmEntregas ..> negocio : prepara y confirma
frmEntregas ..> entidades : muestra pendientes
frmEntregas ..> EstiloGestion

note bottom
Preparar reserva unidades; confirmar registra la entrega al cliente
Los formularios heredan de Form
end note
@enduml
