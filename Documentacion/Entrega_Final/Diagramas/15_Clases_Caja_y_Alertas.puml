@startuml
allowmixing
title 05 - Caja y alertas
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #40576B
  ArrowColor #40576B
}

package "Presentacion" #EAF3FA {
  class frmCaja <<formulario>> {
    -Cargar()
    -ActualizarResumen()
    -Cerrar()
  }
  class frmResumenMensualCaja <<formulario modal>> {
    -Cargar()
    -Mostrar(ResumenMensualCaja)
  }
  class frmMotivoAnulacion <<dialogo>> {
    +Motivo : String
  }
  class frmAlertas <<formulario>> {
    -CargarAsync()
  }
  class DocumentosPrana <<servicio de presentacion>> {
    +GuardarCierre(CierreCaja)
    +Abrir(String)
  }
  class EstiloGestion <<utilidad visual>> {
    ~Grilla(DataGridView)
  }
}

package "Datos" #EAF3FA {
  class CD_Caja {
    +Consultar(fecha: DateTime): CierreCaja
    +ConsultarPeriodo(desde: DateTime, hasta: DateTime): List<MovimientoCaja>
    +Registrar(movimiento: MovimientoCaja, usuario: int): void
    +Anular(id: int, motivo: string, usuario: int): void
    +Cerrar(solicitud: CierreCaja, usuario: int): CierreCaja
    ~{static} Ahora(cn: SqlConnection, tx: SqlTransaction): DateTime
    ~{static} ExigirDiaAbierto(cn: SqlConnection, tx: SqlTransaction, fecha: DateTime): void
    -{static} LeerMovimientos(cn: SqlConnection, tx: SqlTransaction, fecha: DateTime): List<MovimientoCaja>
    -{static} LeerMovimientos(cn: SqlConnection, tx: SqlTransaction, desde: DateTime, hasta: DateTime): List<MovimientoCaja>
  }
}

rectangle "Negocio\nCN_Caja, CN_InformeVentas\nCN_Entrega" as negocio #E8F5E9
package "Entidades" #FFF8E1 {
  class CierreCaja {
    +Numero: int
    +Fecha: DateTime
    +Inicio: DateTime
    +Fin: DateTime
    +SaldoInicial: decimal
    +SaldoInicialUsd: decimal
    +Observaciones: string
    +Usuario: string
    +Movimientos: List<MovimientoCaja>
    +Billetes: List<ConteoBillete>
    +Ingresos(moneda: string, medio: string?): decimal
    +Gastos(moneda: string, medio: string?): decimal
    +Contado(moneda: string): decimal
    +Esperado(moneda: string): decimal
    +Diferencia(moneda: string): decimal
    +BalanceArs: decimal
    +CafeArs: decimal
  }
  class MovimientoCaja {
    +Id: int
    +Venta: int?
    +Fecha: DateTime
    +Concepto: string
    +Tipo: string
    +Medio: string
    +Moneda: string
    +Cuenta: string
    +Importe: decimal
    +Usuario: string
  }
  class ConteoBillete {
    +Moneda: string
    +Denominacion: decimal
    +Cantidad: int
    +Total: decimal
  }
}
rectangle "Otras entidades\nTiposCaja, ResumenMensualCaja\nTotalMensualCaja\nAlertaPagoPendiente\nAlertaStockPendiente" as otrasEntidades #FFF8E1

frmCaja ..> negocio : registra y consulta
frmCaja ..> CierreCaja : consulta y presenta
frmCaja ..> MovimientoCaja : muestra movimientos
frmCaja --> frmResumenMensualCaja : consulta mes
frmCaja --> frmMotivoAnulacion : solicita motivo
frmCaja ..> DocumentosPrana : imprime cierre
DocumentosPrana ..> CierreCaja : genera documento
frmResumenMensualCaja ..> negocio : obtiene resumen
frmResumenMensualCaja ..> otrasEntidades : presenta totales
frmAlertas ..> negocio : consulta alertas
frmAlertas ..> otrasEntidades : muestra resultados
frmCaja ..> EstiloGestion

CD_Caja ..> CierreCaja : Consultar / Cerrar
CD_Caja ..> MovimientoCaja : ConsultarPeriodo / Registrar / LeerMovimientos
CierreCaja "1" --> "0..*" MovimientoCaja : Movimientos
CierreCaja "1" --> "0..*" ConteoBillete : Billetes

note bottom
El cierre de caja y el resumen mensual son operaciones distintas
Los formularios heredan de Form
end note
@enduml
