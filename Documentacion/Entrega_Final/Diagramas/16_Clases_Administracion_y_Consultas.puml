@startuml
allowmixing
title 06 - Informes, historial y administracion
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #40576B
  ArrowColor #40576B
}

package "Presentacion" #EAF3FA {
  class frmInformesVentas <<formulario>> {
    -datos : List<InformeVenta>
    -Consultar()
    -Exportar()
    -pruebaAdmin_Click()
    -eliminarPrueba_Click()
  }
  class frmHistorial <<formulario>> {
    -ConfigurarHistorial()
    -CargarActividades(DateTime, DateTime, int)
  }
  class frmUsuarios <<formulario>> {
    -idSeleccionado : int
    -Cargar()
    -btnGuardar_Click()
    -btnDesbloquear_Click()
    -btnDarDeBaja_Click()
  }
  class DistribucionAdaptable <<utilidad visual>> {
    ~Fila(Control[]) : FlowLayoutPanel
    ~Campo(Label, Control, int) : Panel
    ~Pagina(Form, Control[]) : void
  }
  class EstiloGestion <<utilidad visual>> {
    ~Grilla(DataGridView)
    ~Columna(DataGridView, String, String, int, String)
  }
  class Resources <<recurso generado>> {
    ~ResourceManager
    ~Culture
  }
}

rectangle "Negocio\nCN_InformeVentas\nCN_DatosPrueba\nCN_LogActividad\nCN_Usuario, SesionActual" as negocio #E8F5E9
rectangle "Entidades\nInformeVenta, FiltroInformeVentas\nLoteDatosPrueba, LogActividad\nusuario" as entidades #FFF8E1

frmInformesVentas ..> negocio : consulta y exporta
frmInformesVentas ..> entidades : presenta resultados
frmHistorial ..> negocio : filtra actividad
frmHistorial ..> entidades : presenta registros
frmUsuarios ..> negocio : administra cuentas
frmUsuarios ..> entidades : presenta usuarios
DistribucionAdaptable ..> EstiloGestion

note bottom
La baja logica conserva usuario e historial
Las utilidades y Resources forman parte de Presentacion;
los formularios heredan de Form
end note
@enduml
