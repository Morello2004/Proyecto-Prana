<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome" Version="4.7.0" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Prana.Entidades\Prana.Entidades.csproj" />
<ProjectReference Include="Prana.negocio\Prana.negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="frmNuevaVenta.Logica.resx">
      <ManifestResourceName>Prana.Presentacion.frmNuevaVenta.Logica</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="PantallasAdaptables.resx">
      <ManifestResourceName>Prana.Presentacion.PantallasAdaptables</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="BaseDeDatos\*.sql">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Plantillas\logo-prana.txt" LogicalName="Prana.LogoComprobante" />
    <Compile Remove="Prana.Datos\**\*.cs" />
    <Compile Remove="Prana.Entidades\**\*.cs" />
    <Compile Remove="Prana.negocio\**\*.cs" />
    <Compile Remove="Pruebas\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="frmResumenMensualCaja.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmResumenMensualCaja.Designer.cs"><DependentUpon>frmResumenMensualCaja.cs</DependentUpon></Compile>
    <Compile Update="frmCaja.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmCaja.Designer.cs"><DependentUpon>frmCaja.cs</DependentUpon></Compile>
    <Compile Update="frmAlertas.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmAlertas.Designer.cs"><DependentUpon>frmAlertas.cs</DependentUpon></Compile>
    <Compile Update="frmInformesVentas.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmInformesVentas.Designer.cs"><DependentUpon>frmInformesVentas.cs</DependentUpon></Compile>
    <Compile Update="frmComprobantes.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmComprobantes.Designer.cs"><DependentUpon>frmComprobantes.cs</DependentUpon></Compile>
    <Compile Update="frmMotivoAnulacion.cs"><SubType>Form</SubType></Compile>
    <Compile Update="frmMotivoAnulacion.Designer.cs"><DependentUpon>frmMotivoAnulacion.cs</DependentUpon></Compile>
  </ItemGroup>
</Project>
